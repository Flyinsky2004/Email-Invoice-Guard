# Optional native reverse proxy: replace the domain and include in your
# existing Caddy configuration. The installer does not modify Web services.
invoice.example.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy 127.0.0.1:8080
}
