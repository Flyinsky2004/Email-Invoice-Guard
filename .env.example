# Copy to .env and replace every placeholder. Never commit the real .env.
# The application refuses to start while required values are missing or invalid.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Public HTTPS origin used to build one-time QQ setup links.
# Must be the exact origin users reach through an HTTPS reverse proxy, no path, no trailing slash.
PUBLIC_BASE_URL=https://invoice.example.com

# Telegram bot token from @BotFather. Format: <numeric-id>:<secret>.
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN

# Target chat for deliveries. Group/supergroup IDs are negative.
TELEGRAM_CHAT_ID=-1000000000000

# Comma-separated Telegram user IDs allowed to run commands. At least one.
TELEGRAM_ALLOWED_USER_IDS=100000001,100000002

# Exactly 32 random bytes, standard base64 (44 chars with padding).
# Generate once and keep it with your backups:
#   openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32_BYTES

# Alternative to ENCRYPTION_KEY: a file containing the base64 key.
# Permissions must be owner-only (0600) or startup fails.
# ENCRYPTION_KEY_FILE=/etc/email-invoice-guard/encryption.key

# ---------------------------------------------------------------------------
# Runtime (defaults shown; override only when needed)
# ---------------------------------------------------------------------------

DATABASE_PATH=/var/lib/email-invoice-guard/invoice-guard.db
LISTEN_ADDRESS=127.0.0.1:8080
HEALTH_PATH=/healthz
TIMEZONE=Asia/Taipei
REMINDER_TIME=09:00
SYNC_INTERVAL=60s
SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Telegram tuning
# ---------------------------------------------------------------------------

TELEGRAM_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=25s
TELEGRAM_RATE_INTERVAL=1s

# ---------------------------------------------------------------------------
# Microsoft OAuth (optional; leave MICROSOFT_CLIENT_ID empty to disable)
# ---------------------------------------------------------------------------
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=consumers
# MICROSOFT_REDIRECT_URL=https://invoice.example.com/oauth/microsoft/callback
# MICROSOFT_AUTHORITY_URL=https://login.microsoftonline.com/
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# MICROSOFT_SESSION_TTL=10m

# ---------------------------------------------------------------------------
# QQ IMAP
# ---------------------------------------------------------------------------

IMAP_ADDRESS=imap.qq.com:993
IMAP_SERVER_NAME=imap.qq.com
# Only imap.qq.com is supported; arbitrary IMAP hosts are rejected.
# Explicit QQ-hosted alias domains (comma-separated bare DNS names, no
# scheme/path/port/wildcard). Defaults to qq.com,foxmail.com.
# Every alias still has to pass a real QQ TLS login before it is saved.
QQ_ALLOWED_DOMAINS=qq.com,foxmail.com
# Defaults to PUBLIC_BASE_URL when empty.
# IMAP_PUBLIC_BASE_URL=
IMAP_TIMEOUT=30s
IMAP_SESSION_TTL=15m

# ---------------------------------------------------------------------------
# Manual recurring reminders
# ---------------------------------------------------------------------------
# Operator-declared recurring bills (VPS, domains, subscriptions). Manual
# reminders are enabled by default and never read mail; only an authorized user
# confirmation marks an occurrence paid. All values below are defaults.
# MANUAL_DEFAULT_TIME: HH:MM in 24h form.
MANUAL_DEFAULT_TIME=09:00
# IANA timezone used when a plan does not set its own.
MANUAL_DEFAULT_TIMEZONE=Asia/Taipei
# Retry a failed daily summary (at-least-once delivery).
MANUAL_DAILY_RETRY=true
# Spacing between retries of the same daily summary.
MANUAL_DAILY_INTERVAL=24h
# v1 supports only last_day: billing days beyond a month's length clamp to it.
MANUAL_MONTH_END_POLICY=last_day
# How often the manual scheduler evaluates plans.
MANUAL_SCHEDULER_INTERVAL=30s
# How long an unfinished /reminder_add wizard stays valid.
MANUAL_WIZARD_TTL=10m
# Bounded catch-up window; older missed periods jump to the next billing date.
MANUAL_MAX_CATCHUP_MONTHS=24

# ---------------------------------------------------------------------------
# Reverse proxy trust (CR001)
# ---------------------------------------------------------------------------
# Comma-separated CIDRs whose peers may assert X-Forwarded-Proto: https.
# Empty means forwarded headers are never trusted and direct TLS is mandatory.
# Native reverse proxies on this host only:
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Escape hatch for local development only: allows http:// on loopback hosts.
# NEVER enable this in production.
# ALLOW_INSECURE_HTTP=false
